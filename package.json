    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "manifold-3d": "^3.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19"
